# Copy to .env next to docker-compose.yml and fill in. Never commit .env.

# Bearer token required by /api/* (generate with: openssl rand -hex 32).
API_TOKEN=replace-with-a-long-random-string

# Optional overrides (defaults shown):
# RUST_LOG=info
# STOPS_SYNC_TIME=04:00
# DEFAULT_FEEDS=gtt
# UPSTREAM_TIMEOUT_SECS=10
# DEPARTURES_CACHE_SECS=20
# Empty disables GTT's own predictions and alerts:
# GTT_REALTIME_URL=https://percorsieorari.gtt.to.it/das_gtfsrt/
# GTT_TRIP_UPDATES_CACHE_SECS=20
# GTT_ALERTS_POLL_SECS=300
# How often the scheduler looks for due rules, and how late a summary may still be sent:
# SCHEDULER_TICK_SECS=15
# MISSED_RUN_GRACE_MINUTES=5
# Empty links alerts by line only:
# GTT_GTFS_URL=https://www.gtt.to.it/open_data/gtt_gtfs.zip
# Web Push (needed to receive notifications on the phone). Generate the key with
# `docker run --rm federicosbringhetti/intime vapid-keys` and do not change it later;
# the subject starts with mailto: or https: and is required when the key is set:
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
